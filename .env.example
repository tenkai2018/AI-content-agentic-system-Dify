# ==============================================================================
# AI Content Agentic System — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG BAO GIỜ commit file .env lên Git
# ==============================================================================

# --- LLM Provider ---
# Chọn 1 trong 4 giá trị: "openai" | "anthropic" | "ollama" | "mixed"
# "ollama"  = chỉ dùng Ollama local (miễn phí, private, cần container đang chạy)
# "mixed"   = Ollama cho writing, OpenAI cho reasoning/vision (tiết kiệm cost)
# "openai"  = chỉ dùng OpenAI (GPT-4o)
# "anthropic" = Anthropic cho writing, OpenAI cho reasoning
LLM_PROVIDER="ollama"

# --- Ollama (Local — container tại D:\HUYTQ\docker-volumes\n8n-ollama) ---
# Backend chạy native → localhost:11434
# Backend chạy trong Docker (cùng network) → ollama:11434
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_REASONING="llama3.2"   # Dùng cho: Researcher, Orchestrator
OLLAMA_MODEL_WRITING="llama3.2"     # Dùng cho: Scriptwriter, Repurposer
OLLAMA_MODEL_VISION="llava"         # Dùng cho: Visual Director (cần model llava hoặc llava-llama3)

# --- OpenAI (chỉ cần nếu LLM_PROVIDER="openai" hoặc "mixed") ---
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_MODEL_VISION="gpt-4o"

# --- Anthropic (chỉ cần nếu LLM_PROVIDER="anthropic") ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"


# --- YouTube Data API ---
YOUTUBE_API_KEY="AIza..."

# --- PostgreSQL ---
POSTGRES_USER="content_agent"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_DB="content_machine"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://content_agent:your_secure_password_here@localhost:5432/content_machine"

# --- ChromaDB ---
CHROMA_HOST="localhost"
CHROMA_PORT="8000"

# --- n8n ---
N8N_HOST="localhost"
N8N_PORT="5678"
N8N_BASIC_AUTH_USER="admin"
N8N_BASIC_AUTH_PASSWORD="your_n8n_password"
N8N_ENCRYPTION_KEY="your_encryption_key_here"

# --- Backend (FastAPI) ---
BACKEND_HOST="localhost"
BACKEND_PORT="8080"
SECRET_KEY="your_fastapi_secret_key_here"
ALLOWED_ORIGINS="http://localhost:3000"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:8080"
