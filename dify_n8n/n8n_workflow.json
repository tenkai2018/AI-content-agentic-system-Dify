        ]
      ]
    },
    "Log to FastAPI": {
      "main": [
        [
          {
            "node": "Trigger Dify Workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Dify Workflow": {
      "main": [
        [
          {
            "node": "Log Completion to FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 3600
  },
  "active": false,
  "pinData": {}
}
