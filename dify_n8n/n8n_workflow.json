{
  "name": "Content Machine - Research to Dify Orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "content-machine/start",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-start",
      "name": "Webhook Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        120,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/api/logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"level\": \"INFO\",\n  \"source\": \"n8n\",\n  \"message\": \"content-machine workflow started\",\n  \"details\": {\n    \"niche\": $json.body.niche,\n    \"keywords\": $json.body.keywords\n  }\n}"
      },
      "id": "log-start",
      "name": "Log Start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        320,
        160
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/search",
        "sendQueryParameters": true,
        "queryParameters": {
          "parameters": [
            { "name": "part", "value": "snippet" },
            { "name": "type", "value": "video" },
            { "name": "maxResults", "value": "20" },
            { "name": "q", "value": "={{$json.body.niche + ' ' + ($json.body.keywords || '')}}" },
            { "name": "key", "value": "={{$env.YOUTUBE_API_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "youtube-search",
      "name": "YouTube Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $json.items || [];\nconst normalized = items.map((x) => ({\n  video_id: x?.id?.videoId || '',\n  title: x?.snippet?.title || '',\n  channel: x?.snippet?.channelTitle || '',\n  thumbnail_url: x?.snippet?.thumbnails?.high?.url || x?.snippet?.thumbnails?.default?.url || ''\n})).filter(v => v.video_id);\n\nconst selected = normalized[0] || {\n  video_id: '',\n  title: `${$node['Webhook Start'].json.body.niche} angle`,\n  channel: 'N/A',\n  thumbnail_url: ''\n};\n\nreturn [{\n  json: {\n    niche: $node['Webhook Start'].json.body.niche,\n    language: $node['Webhook Start'].json.body.language || 'en',\n    selected_title: selected.title,\n    reference_thumbnail_url: selected.thumbnail_url,\n    candidates: normalized\n  }\n}];"
      },
      "id": "normalize-research",
      "name": "Normalize Research",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost/v1/workflows/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inputs\": {\n    \"niche\": $json.niche,\n    \"selected_title\": $json.selected_title,\n    \"language\": $json.language,\n    \"reference_thumbnail_url\": $json.reference_thumbnail_url\n  },\n  \"response_mode\": \"blocking\",\n  \"user\": \"content-machine-n8n\"\n}"
      },
      "id": "run-dify",
      "name": "Run Dify Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        760,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "replace-with-your-credential-id",
          "name": "Dify API Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/api/logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"level\": \"INFO\",\n  \"source\": \"dify\",\n  \"message\": \"content-machine dify completed\",\n  \"details\": {\n    \"outputs\": $json.data?.outputs || $json.outputs || {}\n  }\n}"
      },
      "id": "log-complete",
      "name": "Log Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"message\": \"Content Machine workflow executed\",\n  \"research_candidates\": $node['Normalize Research'].json.candidates,\n  \"dify_result\": $node['Run Dify Workflow'].json\n}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Start": {
      "main": [
        [
          { "node": "Log Start", "type": "main", "index": 0 },
          { "node": "YouTube Search", "type": "main", "index": 0 }
        ]
      ]
    },
    "YouTube Search": {
      "main": [
        [
          { "node": "Normalize Research", "type": "main", "index": 0 }
        ]
      ]
    },
    "Normalize Research": {
      "main": [
        [
          { "node": "Run Dify Workflow", "type": "main", "index": 0 }
        ]
      ]
    },
    "Run Dify Workflow": {
      "main": [
        [
          { "node": "Log Completion", "type": "main", "index": 0 }
        ]
      ]
    },
    "Log Completion": {
      "main": [
        [
          { "node": "Respond", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 3600
  },
  "active": false,
  "pinData": {}
}
